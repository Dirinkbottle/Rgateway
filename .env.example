# ─── Rgateway 配置文件 ───
# 复制此文件为 .env 并修改，或直接设置系统环境变量

# Go 业务后端地址
BACKEND_URL=http://127.0.0.1:8080

# 对外服务端口（浏览器访问）
PUBLIC_PORT=3000

# 管理端口（仅 127.0.0.1，供后端调用失效缓存）
ADMIN_PORT=3001

# 默认缓存 TTL，单位秒，259200 = 3 天
CACHE_TTL_SECS=259200

# 最大缓存条目数，超出后 LRU 淘汰
CACHE_MAX_ENTRIES=10000

# Watchdog 安全配置文件路径
WATCHDOG_CONFIG_PATH=watchdog.json

# Admin API Bearer Token（生产环境必须设置一个强随机值）
# 为空时默认拒绝所有管理请求，除非 DEV_ALLOW_INSECURE_ADMIN=true
ADMIN_TOKEN=

# 是否允许无鉴权的管理接口（仅限开发环境，生产环境禁止启用）
# 设为 true 时，ADMIN_TOKEN 为空也可访问管理接口
DEV_ALLOW_INSECURE_ADMIN=false
